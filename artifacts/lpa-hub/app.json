{
  "expo": {
    "name": "LPA",
    "slug": "lpa",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/lpa-outlaws-mark.png",
    "scheme": "lpa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.lpa",
      "buildNumber": "24",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.legendaryprepacademy.lpa",
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/images/lpa-outlaws-mark.png"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "disableLocation": true,
          "iPhoneDeploymentTarget": "16.4"
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/lpa-outlaws-mark.png",
          "resizeMode": "contain",
          "backgroundColor": "#050505"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow LPA to access photos you choose to send in messages.",
          "savePhotosPermission": "Allow LPA to save message images to your photo library.",
          "granularPermissions": []
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "messages",
          "color": "#C47A44"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "822777e1-fbbe-47cf-a894-b815050aaf53"
      }
    },
    "owner": "legendary-prep-academy1"
  }
}
