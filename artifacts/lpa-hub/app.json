{
  "expo": {
    "name": "LPA",
    "slug": "lpa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lpa-outlaws-mark.png",
    "scheme": "lpa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.legendaryprepacademy.lpa"
    },
    "android": {
      "package": "com.legendaryprepacademy.lpa",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/images/lpa-outlaws-mark.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/lpa-outlaws-mark.png",
          "resizeMode": "contain",
          "backgroundColor": "#050505"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow LPA to access photos you choose to send in messages.",
          "savePhotosPermission": "Allow LPA to save message images to your photo library.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "messages",
          "color": "#C47A44"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "822777e1-fbbe-47cf-a894-b815050aaf53"
      }
    },
    "owner": "legendary-prep-academy1"
  }
}
